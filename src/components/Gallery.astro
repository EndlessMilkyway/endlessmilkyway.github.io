---
import sizes from '../data/images.json';

interface Props {
  dir: string;
  files: string[];
  alt: string;
  variant?: 'web' | 'mobile';
}
const { dir, files, alt, variant = 'web' } = Astro.props;
const items = files.map((f, i) => {
  const full = `${dir}/${f}`;
  const thumb = full.replace(/\.webp$/, '.thumb.webp');
  const [width, height] = (sizes as Record<string, number[]>)[thumb] ?? [];
  return { full, thumb, width, height, alt: `${alt} ${i + 1}` };
});
---
<div class={`gallery gallery-${variant}`}>
  {items.map((it) => (
    <a href={it.full} target="_blank" rel="noopener" class="gallery-item">
      <img src={it.thumb} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" />
    </a>
  ))}
</div>
